---
import { ROLES } from "@config";
---

<ol class="flex flex-col">
  {
    ROLES.map(({ organisation, title, period, summary, highlights, links }) => (
      <li class="grid grid-cols-1 md:grid-cols-[10rem_1fr] gap-x-8 gap-y-2 py-6 border-t border-navy">
        <p class="text-sm tabular-nums text-silver md:pt-1">{period}</p>
        <div class="flex flex-col gap-3">
          <h3 class="text-xl font-semibold">
            {organisation}
            <span class="block text-base font-normal">{title}</span>
          </h3>
          <p class="max-w-prose">{summary}</p>
          {highlights.length > 0 && (
            <ul class="list-disc pl-5 flex flex-col gap-1 max-w-prose">
              {highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
          {links.length > 0 && (
            <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
              {links.map(({ label, url }) => (
                <li>
                  <a href={url}>{label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
