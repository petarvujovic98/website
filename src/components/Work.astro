---
import { Image } from "astro:assets";
import type { Project } from "@config";

interface Props {
  project: Project;
  reverse?: boolean;
}

const {
  project: { title, description, image, url, github },
  reverse,
} = Astro.props;
---

<article
  class:list={[
    "grid grid-cols-1 w-full gap-4 py-6 border-t border-sky-300 dark:border-sky-800",
    image && "md:grid-cols-2 md:gap-8",
  ]}
>
  {
    image && (
      <Image
        src={image.src}
        alt={image.alt}
        class="w-full rounded-lg max-h-[320px] object-cover object-top border border-sky-300 dark:border-sky-800"
      />
    )
  }

  <div
    class:list={[
      "flex flex-col gap-3 w-full order-last",
      reverse && "md:order-first",
    ]}
  >
    <h3 class="text-xl font-semibold">
      {url ? <a href={url}>{title}</a> : title}
    </h3>

    <p>{description}</p>

    {
      github && (
        <p>
          <a href={github}>Source on GitHub</a>
        </p>
      )
    }
  </div>
</article>
