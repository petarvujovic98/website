---
import SocialLinks from "./SocialLinks.astro";
import SectionHeading from "./SectionHeading.astro";
import { AVAILABILITY, SITE } from "@config";

const year = new Date().getFullYear();
---

<footer id="contact" class="max-w-screen-lg w-full mx-auto px-4 mt-16">
  <div class="pt-12 pb-10 border-t border-navy">
    <SectionHeading>Contact</SectionHeading>
    <p class="max-w-prose mb-6">{AVAILABILITY}</p>

    <ul class="flex flex-col gap-2 mb-8">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li>
        <a href={SITE.telegramUrl}>Telegram: {SITE.telegramHandle}</a>
      </li>
      <li><a href={SITE.bookingUrl}>Book a call</a></li>
      <li><a href={SITE.companyUrl}>TriUS</a></li>
    </ul>

    <SocialLinks />

    <p class="mt-8 text-sm">&copy; {year} {SITE.name}</p>
  </div>
</footer>
