<ul class="flex flex-row items-center gap-6">
  {
    SOCIALS.map(({ name, url }) => (
      <li>
        <SocialIcon data={{ name, link: url }}>
          <svg slot="icon" aria-hidden="true" viewBox={ICONS[name].viewBox}>
            <path
              fill="currentColor"
              fill-rule={ICONS[name].fillRule}
              d={ICONS[name].path}
            />
          </svg>
        </SocialIcon>
      </li>
    ))
  }
</ul>
