---
import { Image } from "astro:assets";
import headshot from "../assets/headshot.jpg";
import { SITE } from "@config";

const NAV = [
  { label: "Experience", url: "#experience" },
  { label: "How I work", url: "#how-i-work" },
  { label: "Projects", url: "#projects" },
  { label: "Contact", url: "#contact" },
];
---

<header
  class="max-w-screen-lg w-full mx-auto px-4 pt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
>
  <a href="/" class="flex items-center gap-4 font-semibold no-underline">
    <span class="block w-14 h-14 overflow-hidden rounded-full">
      <Image
        src={headshot}
        alt=""
        width={112}
        class="w-full h-full object-cover object-top"
      />
    </span>
    {SITE.name}
  </a>

  <nav aria-label="Sections">
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        NAV.map(({ label, url }) => (
          <li>
            <a href={url}>{label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
