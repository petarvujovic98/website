---
import { HERO, HOW_I_WORK, PROJECTS, PUBLIC_WORK, SITE } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import Experience from "@components/Experience.astro";
import Work from "@components/Work.astro";
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="flex flex-col gap-6 pt-16 pb-12 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
      {HERO.headline}
    </h1>
    <p class="text-lg md:text-xl max-w-prose">{HERO.subhead}</p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href={HERO.primary.url}
        class="no-underline px-5 py-3 rounded-md font-semibold bg-sky-800 text-sky-50 hover:bg-sky-900 dark:bg-sky-300 dark:text-sky-950 dark:hover:bg-sky-200"
      >
        {HERO.primary.label}
      </a>
      <a href={HERO.secondary.url}>{HERO.secondary.label}</a>
    </div>
  </section>

  <section id="experience" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">Experience</h2>
    <Experience />
  </section>

  <section id="how-i-work" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">How I work</h2>
    <div class="flex flex-col gap-4 max-w-prose">
      {HOW_I_WORK.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      PUBLIC_WORK.length > 0 && (
        <div class="mt-6 max-w-prose">
          Public work:
          <ul class="inline-flex flex-wrap gap-x-4 ml-2">
            {PUBLIC_WORK.map(({ label, url }) => (
              <li>
                <a href={url}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section id="projects" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">Selected public projects</h2>
    <div class="flex flex-col">
      {
        PROJECTS.map((project, index) => (
          <Work project={project} reverse={index % 2 === 1} />
        ))
      }
    </div>
  </section>
</BaseLayout>
