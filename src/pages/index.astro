---
import { HERO, PROJECTS, SITE } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import Experience from "@components/Experience.astro";
import Work from "@components/Work.astro";
import SectionHeading from "@components/SectionHeading.astro";

const [beforeAccent, afterAccent] = HERO.headline.split(HERO.accent);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="flex flex-col gap-6 pt-16 pb-12 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
      {beforeAccent}<span class="text-magenta">{HERO.accent}</span>{afterAccent}
    </h1>
    <p class="text-lg md:text-xl max-w-prose">{HERO.subhead}</p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href={HERO.primary.url}
        class="no-underline px-5 py-3 rounded-md font-semibold bg-blue text-night hover:bg-cyan hover:text-night"
      >
        {HERO.primary.label}
      </a>
      <a href={HERO.secondary.url}>{HERO.secondary.label}</a>
    </div>
  </section>

  <section id="experience" class="py-12">
    <SectionHeading>Experience</SectionHeading>
    <Experience />
  </section>

  <section id="projects" class="py-12">
    <SectionHeading>Selected public projects</SectionHeading>
    <div class="flex flex-col">
      {
        PROJECTS.map((project, index) => (
          <Work project={project} reverse={index % 2 === 1} />
        ))
      }
    </div>
  </section>
</BaseLayout>
